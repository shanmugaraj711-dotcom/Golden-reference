{
  "version": 2,
  "rewrites": [
    { "source": "/api/projects", "destination": "/api/projects.py" },
    { "source": "/api/projects/:path*", "destination": "/api/projects.py" },
    { "source": "/api", "destination": "/api/index.py" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
